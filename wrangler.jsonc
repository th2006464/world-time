{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "world-time-foxtang",
  "main": "src/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "worldtime.foxtang.com",
      "custom_domain": true
    }
  ]
}
